# GEMINI_API_KEY: Required for server-side Gemini AI QA, hook extraction, and strategy optimization.
# Configured via Settings > Secrets in AI Studio or Cloudflare Pages Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"

# Optional GitHub GitOps Integration (enables live config commits and workflow_dispatch triggers)
GITHUB_TOKEN=""
GITHUB_REPO="owner/clipforge-pipeline"
GITHUB_BRANCH="main"
GITHUB_WORKFLOW_FILE="clipforge-pipeline.yml"

# Optional Cloudflare Pages / R2 / Workers Integration
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_PROJECT_NAME="clipforge"
CLOUDFLARE_API_TOKEN=""

# Optional Supabase Postgres & Auth Integration (Free -> Pro tier)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Twitch Helix API Integration (enables live Twitch clip radar ingestion)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Optional Remote Control & Alert Bridges (Discord / Telegram / WhatsApp — server-only)
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

